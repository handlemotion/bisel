{
  "name": "bisel-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "bisel zero-knowledge sync server (Cloudflare Worker + Hono + D1)",
  "scripts": {
    "predev": "node scripts/ensure-dev-vars.mjs && pnpm migrate",
    "dev": "wrangler dev --port 8787",
    "migrate": "wrangler d1 migrations apply bisel --local",
    "reset": "rm -rf .wrangler/state",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "wrangler": "4.154.0"
  },
  "packageManager": "pnpm@12.16.1"
}

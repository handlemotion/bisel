{
  "manifest_version": 3,
  "name": "Bisel",
  "version": "0.1.6",
  "description": "Offers to save a login to Bisel when you sign in.",
  "key": "",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "prompt.html"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}

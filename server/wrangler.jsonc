{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,

  // ---- default environment = local development ---------------------------------------------
  // `pnpm dev`, `pnpm test` and everything under apple/ use this one, with a local D1 only.
  // Nothing in this block can reach a real Cloudflare resource; the database_id is a placeholder.
  "name": "bisel-server-dev",
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bisel",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Per-address flood limit (CF-Connecting-IP; requests without it, i.e. local dev, are not limited).
  // Cloudflare's Workers rate-limiting binding; `namespace_id` only has to be unique within the account.
  // A device syncs once a minute and writes a handful of items; 300/min leaves room for a bulk import.
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],
  // The dashboard: static files from public/ (built by `pnpm build:web`) served by the same Worker on the same hostname.
  // Only these paths run the Worker first; everything else is a static file, and unknown paths fall back to index.html
  // so /connect works as a deep link. /v1/* keeps its uniform bare 404 for anything that is not a real, signed route.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/api/*", "/healthz"]
  },
  "build": { "command": "pnpm build:web" },
  "vars": {
    // Where the dashboard lives; passkeys are bound to its hostname and the session cookie to its scheme.
    "PUBLIC_ORIGIN": "http://localhost:8787",
    // Failed-auth budget per client IP (CF-Connecting-IP): after AUTH_FAIL_LIMIT failures inside
    // AUTH_FAIL_WINDOW_SECONDS the IP's *failing* requests stop costing D1 writes and are answered
    // AUTH_BACKOFF_MS late. Valid signatures are never refused because of this counter.
    "AUTH_FAIL_LIMIT": "20",
    "AUTH_FAIL_WINDOW_SECONDS": "600",
    "AUTH_BACKOFF_MS": "1000",
    // Previous item blobs / wrapped keys are kept this long so a bad write can be undone by the owner.
    "HISTORY_RETENTION_DAYS": "30",
    // Most items (live and tombstones) one box may hold; a new item beyond it is answered 409 box_full.
    "MAX_ITEMS_PER_BOX": "5000",
    // A device registered through the recovery phrase can only sign requests after this delay (0 = immediately).
    "RECOVERY_ACTIVATION_DELAY_SECONDS": "0"
  },

  // ---- production --------------------------------------------------------------------------
  // Deploy only by following DEPLOY.md: `pnpm exec wrangler deploy --env prod`.
  // Every REPLACE_… value below must be filled in; wrangler refuses to deploy while the D1 id is a
  // placeholder. No secret lives in this file: BOOTSTRAP_TOKEN is a Worker secret
  // (`wrangler secret put BOOTSTRAP_TOKEN --env prod`); BETTER_AUTH_SECRET (the dashboard session signing key) is the same kind.
  "env": {
    "prod": {
      "name": "bisel-server",
      "workers_dev": false,
      "preview_urls": false,
      // The Worker answers only on this hostname. `custom_domain` makes wrangler create the proxied DNS
      // record and the certificate itself (the bisel.app zone must be on this Cloudflare account, and
      // the apex stays free for the marketing site). The name is public: what protects the server is
      // that every request must carry a device signature, not that the address is hidden.
      "routes": [{ "pattern": "box.bisel.app", "custom_domain": true }],
      // Logs on, but only the lines the Worker writes itself (hashed address, truncated device id,
      // path, status; never bodies, blobs, keys, tokens or headers). No automatic invocation logs and no
      // traces, which would record every request URL; query strings are redacted regardless.
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": { "enabled": true, "invocation_logs": false },
        "traces": { "enabled": false }
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bisel",
          // 5a01b8bc-fb58-4ac7-92f7-b600869c8f0c: the id printed by `wrangler d1 create bisel` (DEPLOY.md step 3).
          "database_id": "5a01b8bc-fb58-4ac7-92f7-b600869c8f0c",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/v1/*", "/api/*", "/healthz"]
      },
      "build": { "command": "pnpm build:web" },
      "vars": {
        "PUBLIC_ORIGIN": "https://box.bisel.app",
        "AUTH_FAIL_LIMIT": "20",
        "AUTH_FAIL_WINDOW_SECONDS": "600",
        "AUTH_BACKOFF_MS": "1000",
        "HISTORY_RETENTION_DAYS": "30",
        "MAX_ITEMS_PER_BOX": "5000",
        // 24 h: someone who has seen the 24 words once cannot silently take the vault; every enrolled device is
        // told on its next sync and can cancel. Set to "0" to recover instantly.
        "RECOVERY_ACTIVATION_DELAY_SECONDS": "86400"
      }
    }
  }
}

{
  "name": "bisel-server",
  "version": "0.1.0",
  "private": true,
  "description": "bisel zero-knowledge sync server (Cloudflare Worker + Hono + D1)",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-dev-vars.mjs && pnpm migrate",
    "dev": "wrangler dev --port 8787",
    "build:web": "node scripts/build-web.mjs",
    "migrate": "wrangler d1 migrations apply bisel --local",
    "reset": "rm -rf .wrangler/state",
    "types": "wrangler types",
    "deploy:prod": "wrangler deploy --env prod",
    "test": "vitest run",
    "test:legacy": "vitest run -c vitest.legacy.config.ts",
    "test:browser": "playwright test",
    "check-types": "tsc --noEmit && tsc --noEmit -p web",
    "build": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.18",
    "better-auth": "1.7.18",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}

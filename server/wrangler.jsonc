{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bisel-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bisel",
      // Placeholder: only used by `wrangler dev` / `--local`, never touches Cloudflare.
      // Replace with the real id only when a deployed instance is created (see README).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Worker-side failed-auth backoff: after AUTH_FAIL_LIMIT failures from one IP
    // inside AUTH_FAIL_WINDOW_SECONDS, that IP gets the uniform 404 for everything.
    "AUTH_FAIL_LIMIT": "20",
    "AUTH_FAIL_WINDOW_SECONDS": "600"
  }
}

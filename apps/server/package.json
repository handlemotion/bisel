{
  "name": "bisel-server",
  "version": "0.1.0",
  "private": true,
  "description": "bisel zero-knowledge sync server (Cloudflare Worker + Hono + D1)",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-dev-vars.mjs && pnpm migrate",
    "dev": "wrangler dev --port 8787",
    "build:web": "node scripts/build-web.mjs",
    "migrate": "wrangler d1 migrations apply bisel --local",
    "reset": "rm -rf .wrangler/state",
    "types": "wrangler types",
    "deploy:prod": "wrangler deploy --env prod",
    "test": "playwright test",
    "test:legacy": "playwright test -c playwright.legacy.config.ts",
    "test:report": "playwright show-report",
    "check-types": "tsc --noEmit && tsc --noEmit -p web",
    "build": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.23",
    "better-auth": "1.6.23",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "wrangler": "4.154.0"
  }
}
